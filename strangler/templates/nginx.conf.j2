worker_processes 1;
error_log /var/log/nginx/error.log notice;
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format migration '$time_iso8601 route=$migration_route backend=$migration_backend status=$status latency_ms=$request_time';
    access_log /var/log/nginx/access.log migration;
    map $http_x_request_id $request_key {
        default $http_x_request_id;
        "" $request_id;
    }
    upstream legacy_upstream { server legacy:80; }
    upstream console_upstream { server console:8000; }
    # Candidates are resolved per request through Docker's DNS, so the façade
    # still reloads (and rolls back) when a candidate container is gone.
    resolver 127.0.0.11 valid=5s ipv6=off;
    # Route and backend are derived with map, never with "set": a mirror
    # subrequest shares the parent request's variable slots, so "set" in the
    # shadow location would overwrite the values before the main request is
    # logged, and the cutover gate reads that log.
    map $uri $migration_route {
        default "other";
{% for slice_name, slice in slices.items() %}
{% for route in slice.routes %}
        {{ route }} "{{ slice_name }}";
{% endfor %}
{% endfor %}
    }
    map $migration_route $migration_backend {
        default "legacy";
{% for slice_name, slice in slices.items() %}
{% if slice.upstream and slice.candidate %}
        {{ slice_name }} ${{ slice_name }}_backend;
{% endif %}
{% endfor %}
    }
{% for slice_name, slice in slices.items() %}
{% if slice.upstream and slice.candidate %}
    split_clients $request_key ${{ slice_name }}_backend {
{% if slice.weight <= 0 %}
        * legacy;
{% elif slice.weight >= 100 %}
        * candidate;
{% else %}
        {{ slice.weight }}% candidate;
        * legacy;
{% endif %}
    }
    map ${{ slice_name }}_backend ${{ slice_name }}_upstream {
        legacy http://legacy_upstream;
        candidate http://{{ slice.candidate }};
    }
    map $migration_route ${{ slice_name }}_shadow {
        default http://{{ slice.candidate }};
    }
{% endif %}
{% endfor %}
    server {
        listen 80;
        location ^~ /_migration {
            proxy_pass http://console_upstream;
        }
{% for slice_name, slice in slices.items() %}
{% for route in slice.routes %}
        location = {{ route }} {
{% if slice.upstream and slice.candidate %}
{% if slice.mirror %}
            mirror /_shadow_{{ slice_name }};
{% endif %}
            proxy_pass ${{ slice_name }}_upstream$request_uri;
            proxy_connect_timeout 2s;
{% else %}
            proxy_pass http://legacy_upstream;
{% endif %}
            proxy_set_header Host $host;
            proxy_set_header X-Migration-Backend $migration_backend;
        }
{% endfor %}
{% endfor %}
{% for slice_name, slice in slices.items() %}
{% if slice.upstream and slice.candidate and slice.mirror %}
        location = /_shadow_{{ slice_name }} {
            internal;
            proxy_pass ${{ slice_name }}_shadow$request_uri;
            proxy_connect_timeout 2s;
            proxy_set_header X-Migration-Mirror 1;
            access_log off;
        }
{% endif %}
{% endfor %}
        location / {
            proxy_pass http://legacy_upstream;
            proxy_set_header Host $host;
        }
    }
}
