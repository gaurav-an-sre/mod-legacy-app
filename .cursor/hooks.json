{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Delete",
        "command": "python3 .cursor/hooks/deny_protected_writes.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/deny_protected_writes.py",
        "failClosed": true
      }
    ]
  }
}
